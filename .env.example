# VoiceTrace Environment Configuration Example
# Copy this file to .env or .env.local to customize.

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Optional PostgreSQL connection URL (e.g., postgres://user:pass@localhost:5432/voicetrace)
# If left empty, VoiceTrace automatically uses in-process WASM PostgreSQL (@electric-sql/pglite)
# ensuring 100% genuine PostgreSQL behavior with zero external dependencies.
DATABASE_URL=

# Local data directory for file/audio persistence
DATA_DIR=./data

# -----------------------------------------------------------------------------
# RIME TTS CONFIGURATION (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# -----------------------------------------------------------------------------
# Required for live Rime audio synthesis.
# If omitted, VoiceTrace operates in deterministic local fixture mode, producing
# valid synthetic audio clearly flagged with isSynthetic: true.
RIME_API_KEY=
RIME_MODEL=coda
RIME_VOICE=astra
RIME_LANGUAGE=en
RIME_ENDPOINT=https://users.rime.ai/v1/rime-tts
RIME_AUDIO_FORMAT=mp3
RIME_TRANSPORT=http_streaming

# -----------------------------------------------------------------------------
# LIVEKIT CONFIGURATION (SERVER-SIDE ONLY - OPTIONAL REALTIME TRANSPORT)
# -----------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# -----------------------------------------------------------------------------
# QWEN AI BRAIN CONFIGURATION (SERVER-SIDE ONLY - OPTIONAL REALTIME REASONING)
# -----------------------------------------------------------------------------
# Qwen / DashScope API Key (get from https://dashscope.console.aliyun.com)
QWEN_API_KEY=
# Optional Qwen Model (e.g., qwen-plus, qwen-turbo, qwen2.5-72b-instruct)
QWEN_MODEL=qwen-plus
# Optional custom OpenAI-compatible endpoint for Qwen (defaults to DashScope)
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1


# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# OAUTH / SSO CONFIGURATION (OPTIONAL - INSTANT ZERO-CONFIG DEV AUTH INCLUDED)
# -----------------------------------------------------------------------------
# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google Cloud OAuth 2.0 Client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Atlassian Bitbucket Consumer
BITBUCKET_CLIENT_KEY=
BITBUCKET_CLIENT_SECRET=

# GitLab OAuth Application
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
